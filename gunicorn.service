[Unit]
Description=demo fastapi application
After=network.target

[Service]
User=manav
Group=manav
WorkingDirectory=/home/manav/app/src/
Environment="PATH=/home/manav/app/venv/bin"
EnvironmentFile = /home/manav/.env
ExecStart=/home/manav/app/venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker app.main:app --bind 0.0.0.0:8000

[Install]
WantedBy=multi-user.target